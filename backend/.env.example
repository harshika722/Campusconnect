PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
JWT_SECRET=change_this_to_a_long_random_string

# Frontend ka address (forgot password ka reset link isi se banta hai)
CLIENT_URL=http://127.0.0.1:5500/frontend

# Forgot password email (khali chhodo to link backend terminal mein print hota hai)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
BREVO_API_KEY=
MAIL_FROM=CampusConnect <your_sender@example.com>

GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
